# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Used by docker-compose.yml via env_file. For Fly.io / Railway set these
# same values as secrets/env vars in their dashboards instead.

# Port the engine listens on (host and container). Default 8902.
PORT=8902

# Required. Long random string — guards admin endpoints and WS auth.
# Generate one:  openssl rand -hex 32
ISLAND_SECRET=

# Optional engine tuning (milliseconds between agent-to-agent conversations).
CONVO_INTERVAL_MS=

# ---- Resident brain (optional) ----------------------------------------
# When LLM_API_KEY is unset, residents answer with the built-in templates.
# Any OpenAI-compatible POST /v1/chat/completions endpoint works.
# Put the real key only in server/.env (gitignored) or the host's secret
# store. Never commit it.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=8000

# ---- Slack bridge (optional) -------------------------------------------
# Only needed when running `docker compose --profile slack up` (or an
# equivalent second process on Fly/Railway). See DEPLOY.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
SLACK_RESIDENT_NAME=Slackbot
SLACK_RELAY_ALL=false
